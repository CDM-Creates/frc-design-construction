# OpenAI / text-model provider
OPENAI_API_KEY=sk-proj-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
DEFAULT_TEXT_PROVIDER=openai

# Optional OpenAI-compatible multi-provider router (for example, a managed AI router)
AI_ROUTER_API_KEY=
AI_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# Task-by-task provider and model routing. Provider values installed here: openai or router.
PROPERTY_ANALYSIS_PROVIDER=openai
PROPERTY_ANALYSIS_MODEL=gpt-4.1-mini
DESIGN_CONCEPT_PROVIDER=openai
DESIGN_CONCEPT_MODEL=gpt-4.1-mini
INTERIOR_DESIGN_PROVIDER=openai
INTERIOR_DESIGN_MODEL=gpt-4.1-mini
ROOM_SCHEDULE_PROVIDER=openai
ROOM_SCHEDULE_MODEL=gpt-4.1-mini
IMAGE_PROMPT_PROVIDER=openai
IMAGE_PROMPT_MODEL=gpt-4.1-mini
FINAL_REPORT_PROVIDER=openai
FINAL_REPORT_MODEL=gpt-4.1-mini

# Concept images. Leave disabled until budget, storage and provider limits are confirmed.
ENABLE_AI_IMAGES=false
IMAGE_PROVIDER=openai
EXTERIOR_IMAGE_MODEL=gpt-image-1
INTERIOR_IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium

# Secure upload links. Use a long, random production secret.
FILE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Abuse controls
SIMULATION_RATE_LIMIT=3

# Automatic quote and completed-project email delivery
RESEND_API_KEY=re_your_api_key
HEAD_ARCHITECT_EMAIL=sheila_delmonte@yahoo.com
QUOTE_FROM_EMAIL="FRC Website <quotes@your-verified-domain.com>"

# Protects architect-only overrides on internal handover routes.
ARCHITECT_REVIEW_TOKEN=replace-with-a-long-random-token
