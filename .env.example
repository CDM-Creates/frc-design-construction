# FRC quote pathway (preferred)
# Simulator and homepage quotes email FRC. No Stripe/OpenAI required for that flow.
# See docs/QUOTE-SYSTEM.md
RESEND_API_KEY=
QUOTE_TO_EMAIL=frcdesignconstruction@gmail.com
HEAD_ARCHITECT_EMAIL=frcdesignconstruction@gmail.com
QUOTE_FROM_EMAIL="FRC Website <onboarding@resend.dev>"
# For production, verify your domain in Resend, then use e.g.:
# QUOTE_FROM_EMAIL="FRC Website <quotes@frcdesignandconstruction.com.au>"

# --- Optional / legacy below (not used by the quote-request pathway) ---

# OpenAI / text-model provider (legacy concept / report experiments)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-terra
DEFAULT_TEXT_PROVIDER=openai

# Optional OpenAI-compatible multi-provider router (for example, a managed AI router)
AI_ROUTER_API_KEY=
AI_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# Task-by-task provider and model routing. Provider values installed here: openai or router.
PROPERTY_ANALYSIS_PROVIDER=openai
PROPERTY_ANALYSIS_MODEL=gpt-5.6-terra
# Optional public web research for non-NSW properties. It retains source URLs
# and unknowns; it never fabricates certificates or bypasses paid/login sources.
PROPERTY_RESEARCH_AI_ENABLED=false
PROPERTY_RESEARCH_AI_MODEL=gpt-5.6-terra
DESIGN_CONCEPT_PROVIDER=openai
DESIGN_CONCEPT_MODEL=gpt-4.1-mini
INTERIOR_DESIGN_PROVIDER=openai
INTERIOR_DESIGN_MODEL=gpt-4.1-mini
ROOM_SCHEDULE_PROVIDER=openai
ROOM_SCHEDULE_MODEL=gpt-4.1-mini
IMAGE_PROMPT_PROVIDER=openai
IMAGE_PROMPT_MODEL=gpt-4.1-mini
FINAL_REPORT_PROVIDER=openai
FINAL_REPORT_MODEL=gpt-5.6-sol

# Client report visuals. False disables both live and mock AI concepts while
# retaining evidence-backed maps and deterministic report graphics.
ENABLE_AI_VISUALS=false
# Legacy image switch retained for the non-report concept workflow.
ENABLE_AI_IMAGES=false
IMAGE_PROVIDER=openai
EXTERIOR_IMAGE_MODEL=gpt-image-1
INTERIOR_IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium

# Secure upload links. Use a long, random production secret.
FILE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# FRC planning-report platform. Keep live services disabled until readiness passes.
FRC_PLATFORM_MODE=test
FRC_DATA_BACKEND=node
FRC_LOCAL_DATA_DIR=
FRC_LOCAL_PRIVATE_STORAGE_DIR=
MALWARE_SCANNER_PROVIDER=

# Supabase production persistence. Set FRC_DATA_BACKEND=supabase in Vercel.
# Use the Supabase transaction-pooler Postgres URL; the app creates/updates its
# tables automatically. Keep both database and service-role values server-only.
SUPABASE_URL=
SUPABASE_DATABASE_URL=
# Preferred current server credential (starts with sb_secret_). Never expose it.
SUPABASE_SECRET_KEY=
# Legacy fallback only; leave empty when SUPABASE_SECRET_KEY is used.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=frc-private-reports

# Report AI adapter. Mock is deterministic and does not call an external API.
REPORT_AI_PROVIDER=mock
REPORT_AI_MODEL=gpt-5.6-sol
REPORT_AI_API_KEY=
REPORT_AI_ENABLED=false

# Immediate upload relevance checks. When required=true, an irrelevant,
# unreadable or unverified prerequisite document blocks checkout.
DOCUMENT_AI_PROVIDER=mock
DOCUMENT_AI_MODEL=gpt-5.6-terra
DOCUMENT_AI_ENABLED=false
DOCUMENT_AI_REQUIRED=false

# Architectural visualisation adapter. It is inactive unless
# ENABLE_AI_VISUALS=true as well as the provider-specific switch below.
ARCHITECTURAL_IMAGE_PROVIDER=mock
ARCHITECTURAL_IMAGE_MODEL=
ARCHITECTURAL_IMAGE_API_KEY=
ARCHITECTURAL_IMAGE_ENABLED=false

# Payment adapter. Live checkout must remain false until legal, tax and webhook checks pass.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MOCK_SECRET=replace-with-a-long-local-test-secret
# Stripe / live payments — DISABLED for the quote pathway.
# Checkout, mock-payment and webhook routes return 410. Keep keys empty unless you re-enable payments later.
PAYMENTS_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Business, tax, legal and reviewer configuration. Do not guess these values.
FRC_BUSINESS_LEGAL_NAME=
FRC_TRADING_NAME="FRC Design & Construction"
FRC_ABN=
FRC_GST_REGISTERED=
FRC_BUSINESS_EMAIL=
FRC_TERMS_URL=
FRC_PRIVACY_URL=
FRC_REFUND_POLICY_URL=
FRC_REPORT_LIMITATIONS_URL=
FRC_REVIEWER_NAME=
FRC_REVIEWER_ROLE=
FRC_REVIEWER_REGISTRATION_JURISDICTION=
FRC_REVIEWER_REGISTRATION_NUMBER=
FRC_CLIENT_BASE_URL=http://localhost:3000
REPORT_PDF_RENDERER=

# Server-controlled delivery and evidence-backed marketing settings.
FRC_AI_TURNAROUND_TARGET_ENABLED=true
FRC_REPORT_PACK_EXPIRY_HOURS=168
FRC_COMPARISON_CLAIM_WORDING=
FRC_COMPARISON_CLAIM_SOURCE=
FRC_COMPARISON_CLAIM_DATE=
FRC_COMPARISON_SERVICE_DEFINITION=
FRC_COMPARISON_CLAIM_EXPIRES_AT=

# Abuse controls
SIMULATION_RATE_LIMIT=3

# Protects architect-only overrides on internal handover routes.
ARCHITECT_REVIEW_TOKEN=replace-with-a-long-random-token
