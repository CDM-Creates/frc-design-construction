# OpenAI / text-model provider
OPENAI_API_KEY=sk-proj-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
DEFAULT_TEXT_PROVIDER=openai

# Optional OpenAI-compatible multi-provider router (for example, a managed AI router)
AI_ROUTER_API_KEY=
AI_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# Task-by-task provider and model routing. Provider values installed here: openai or router.
PROPERTY_ANALYSIS_PROVIDER=openai
PROPERTY_ANALYSIS_MODEL=gpt-4.1-mini
DESIGN_CONCEPT_PROVIDER=openai
DESIGN_CONCEPT_MODEL=gpt-4.1-mini
INTERIOR_DESIGN_PROVIDER=openai
INTERIOR_DESIGN_MODEL=gpt-4.1-mini
ROOM_SCHEDULE_PROVIDER=openai
ROOM_SCHEDULE_MODEL=gpt-4.1-mini
IMAGE_PROMPT_PROVIDER=openai
IMAGE_PROMPT_MODEL=gpt-4.1-mini
FINAL_REPORT_PROVIDER=openai
FINAL_REPORT_MODEL=gpt-4.1-mini

# Concept images. Leave disabled until budget, storage and provider limits are confirmed.
ENABLE_AI_IMAGES=false
IMAGE_PROVIDER=openai
EXTERIOR_IMAGE_MODEL=gpt-image-1
INTERIOR_IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium

# Secure upload links. Use a long, random production secret.
FILE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# FRC planning-report platform. Keep live services disabled until readiness passes.
FRC_PLATFORM_MODE=test
FRC_LOCAL_DATA_DIR=
FRC_LOCAL_PRIVATE_STORAGE_DIR=
MALWARE_SCANNER_PROVIDER=

# Report AI adapter. Mock is deterministic and does not call an external API.
REPORT_AI_PROVIDER=mock
REPORT_AI_MODEL=
REPORT_AI_API_KEY=
REPORT_AI_ENABLED=false

# Architectural visualisation adapter. Mock mode creates validated fixture metadata only.
# Keep the live provider disabled until prompts, storage, moderation and professional review are verified.
ARCHITECTURAL_IMAGE_PROVIDER=mock
ARCHITECTURAL_IMAGE_MODEL=
ARCHITECTURAL_IMAGE_API_KEY=
ARCHITECTURAL_IMAGE_ENABLED=false

# Payment adapter. Live checkout must remain false until legal, tax and webhook checks pass.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MOCK_SECRET=replace-with-a-long-local-test-secret
PAYMENTS_LIVE_ENABLED=false

# Business, tax, legal and reviewer configuration. Do not guess these values.
FRC_BUSINESS_LEGAL_NAME=
FRC_TRADING_NAME="FRC Design & Construction"
FRC_ABN=
FRC_GST_REGISTERED=
FRC_BUSINESS_EMAIL=
FRC_TERMS_URL=
FRC_PRIVACY_URL=
FRC_REFUND_POLICY_URL=
FRC_REPORT_LIMITATIONS_URL=
FRC_REVIEWER_NAME=
FRC_REVIEWER_ROLE=
FRC_REVIEWER_REGISTRATION_JURISDICTION=
FRC_REVIEWER_REGISTRATION_NUMBER=
FRC_CLIENT_BASE_URL=http://localhost:3000
REPORT_PDF_RENDERER=

# Server-controlled delivery and evidence-backed marketing settings.
FRC_AI_TURNAROUND_TARGET_ENABLED=true
FRC_REPORT_PACK_EXPIRY_HOURS=168
FRC_COMPARISON_CLAIM_WORDING=
FRC_COMPARISON_CLAIM_SOURCE=
FRC_COMPARISON_CLAIM_DATE=
FRC_COMPARISON_SERVICE_DEFINITION=
FRC_COMPARISON_CLAIM_EXPIRES_AT=

# Abuse controls
SIMULATION_RATE_LIMIT=3

# Automatic quote and completed-project email delivery
RESEND_API_KEY=re_your_api_key
HEAD_ARCHITECT_EMAIL=sheila_delmonte@yahoo.com
QUOTE_FROM_EMAIL="FRC Website <quotes@your-verified-domain.com>"

# Protects architect-only overrides on internal handover routes.
ARCHITECT_REVIEW_TOKEN=replace-with-a-long-random-token
